{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Connected dot plot (dumbbell). Every Victorian council is one row, ordered by what it spends to service a garbage bin for a year. The solid dot is the garbage bin, the hollow dot the recycling bin, and the bar between them is coloured by the share the council keeps out of landfill. Shaded bands mark quarters of the list: the dearest quarter keeps a median 39 per cent out of landfill, the cheapest 66 per cent.",
  "width": 720,
  "height": 830,
  "data": {
    "url": "data/council_snapshot_latest.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "transform": [
    {
      "calculate": "datum.garbage_cost_per_bin - datum.recycling_cost_per_bin",
      "as": "gap"
    },
    {
      "calculate": "datum.garbage_cost_per_bin >= 166.5 ? 'dear' : datum.garbage_cost_per_bin >= 138.5 ? 'q3' : datum.garbage_cost_per_bin >= 106 ? 'q2' : 'cheap'",
      "as": "q"
    }
  ],
  "encoding": {
    "y": {
      "field": "Council",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelFontSize": 10.5,
        "labelLimit": 180,
        "domain": false,
        "ticks": false,
        "labelPadding": 4,
        "labelFontWeight": {
          "condition": {
            "test": "datum.label === focusCouncil",
            "value": 700
          },
          "value": 400
        },
        "labelColor": {
          "condition": {
            "test": "datum.label === focusCouncil",
            "value": "#111111"
          },
          "value": "#5B6258"
        }
      },
      "scale": {
        "domain": [
          "Melbourne City",
          "Northern Grampians Shire",
          "Hindmarsh Shire",
          "Yarriambiack Shire",
          "Mount Alexander Shire",
          "Towong Shire",
          "Ararat Rural City",
          "Hume City",
          "Glenelg Shire",
          "Moorabool Shire",
          "Brimbank City",
          "Ballarat City",
          "Wellington Shire",
          "South Gippsland Shire",
          "Central Goldfields Shire",
          "Port Phillip City",
          "Maribyrnong City",
          "Greater Dandenong City",
          "Golden Plains Shire",
          "Moira Shire",
          "Moyne Shire",
          "Wyndham City",
          "Loddon Shire",
          "Baw Baw Shire",
          "Melton City",
          "West Wimmera Shire",
          "Latrobe City",
          "Greater Geelong City",
          "Gannawarra Shire",
          "Stonnington City",
          "Casey City",
          "Corangamite Shire",
          "Kingston City",
          "Campaspe Shire",
          "Murrindindi Shire",
          "Maroondah City",
          "Frankston City",
          "Cardinia Shire",
          "Moonee Valley City",
          "Strathbogie Shire",
          "Hobsons Bay City",
          "Greater Bendigo City",
          "Southern Grampians Shire",
          "Indigo Shire",
          "Darebin City",
          "Merri-bek City",
          "Pyrenees Shire",
          "Whitehorse City",
          "Hepburn Shire",
          "Wangaratta Rural City",
          "Banyule City",
          "Mansfield Shire",
          "Boroondara City",
          "Whittlesea City",
          "Alpine Shire",
          "Swan Hill Rural City",
          "Yarra Ranges Shire",
          "Macedon Ranges Shire",
          "Glen Eira City",
          "Horsham Rural City",
          "Colac Otway Shire",
          "Borough of Queenscliffe",
          "Bayside City",
          "Greater Shepparton",
          "Yarra City",
          "Surf Coast Shire",
          "Nillumbik Shire",
          "Knox City",
          "Manningham City",
          "Buloke Shire",
          "Mornington Peninsula Shire",
          "Warrnambool City",
          "Monash City",
          "Bass Coast Shire",
          "Wodonga City",
          "Benalla Rural City",
          "East Gippsland Shire",
          "Mitchell Shire",
          "Mildura Rural City"
        ]
      }
    }
  },
  "layer": [
    {
      "description": "Quarters of the list by garbage-bin cost, shaded alternately (a subtle enclosure).",
      "mark": {
        "type": "rect",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "x2": {
          "datum": 490
        },
        "color": {
          "field": "q",
          "type": "nominal",
          "scale": {
            "domain": [
              "dear",
              "q3",
              "q2",
              "cheap"
            ],
            "range": [
              "#F1F3EE",
              "#FFFFFF",
              "#F1F3EE",
              "#FFFFFF"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4.5,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "recycling_cost_per_bin",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              490
            ],
            "nice": false
          },
          "title": null,
          "axis": {
            "format": "$,.0f",
            "orient": "top",
            "tickCount": 6,
            "grid": true,
            "gridColor": "#E8EAE3",
            "gridWidth": 1
          }
        },
        "x2": {
          "field": "garbage_cost_per_bin"
        },
        "color": {
          "field": "lgprf_diversion_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              30,
              40,
              50,
              60
            ],
            "range": [
              "#CCECE6",
              "#99D8C9",
              "#66C2A4",
              "#2CA25F",
              "#006D2C"
            ]
          },
          "legend": {
            "title": "Share kept out of landfill",
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleLimit": 300,
            "offset": 4,
            "labelExpr": "isFinite(datum.value) ? datum.value + '%' : ''"
          }
        },
        "opacity": {
          "condition": {
            "test": "focusCouncil === '' || datum.Council === focusCouncil",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "recycling_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Recycling bin"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Garbage bin"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Kept out of landfill (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "recycling_cost_per_bin",
            "garbage_cost_per_bin"
          ],
          "as": [
            "costtype",
            "cost"
          ]
        },
        {
          "calculate": "datum.costtype === 'garbage_cost_per_bin' ? 'Garbage bin' : 'Recycling bin'",
          "as": "binlabel"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 58,
        "filled": true,
        "stroke": "#14171A",
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "cost",
          "type": "quantitative"
        },
        "fill": {
          "field": "binlabel",
          "type": "nominal",
          "scale": {
            "domain": [
              "Recycling bin",
              "Garbage bin"
            ],
            "range": [
              "#FFFFFF",
              "#14171A"
            ]
          },
          "legend": {
            "title": "Cost of one bin, a year",
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 120,
            "symbolStrokeColor": "#2C3329",
            "symbolStrokeWidth": 1.4,
            "titleLimit": 300,
            "offset": 4
          }
        },
        "opacity": {
          "condition": {
            "test": "focusCouncil === '' || datum.Council === focusCouncil",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "binlabel",
            "title": "Bin"
          },
          {
            "field": "cost",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost a year"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Council === 'Melbourne City'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11.5,
        "fontWeight": 700,
        "color": "#14171A",
        "dx": -9,
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "strokeOpacity": 0.9,
        "fillOpacity": 1
      },
      "encoding": {
        "x": {
          "field": "recycling_cost_per_bin",
          "type": "quantitative"
        },
        "text": {
          "value": "$476 a bin, 28% kept out"
        }
      }
    },
    {
      "description": "The finding, written into the empty right-hand side of each quarter.",
      "data": {
        "values": [
          {
            "Council": "Moorabool Shire",
            "t": [
              "Dearest quarter, $167 to $476",
              "median 39% kept out of landfill"
            ]
          },
          {
            "Council": "Stonnington City",
            "t": [
              "Next quarter, $139 to $164",
              "median 47%"
            ]
          },
          {
            "Council": "Hepburn Shire",
            "t": [
              "Next quarter, $106 to $138",
              "median 57%"
            ]
          },
          {
            "Council": "Manningham City",
            "t": [
              "Cheapest quarter, $53 to $105",
              "median 66% kept out of landfill"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#14171A",
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 318,
          "type": "quantitative"
        },
        "y": {
          "field": "Council",
          "type": "nominal"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "background": null
}