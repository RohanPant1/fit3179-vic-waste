{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bivariate choropleth. Each Victorian council is shaded by two measures at once: how well off it is on the 2021 census index of disadvantage, and how much kerbside waste it keeps out of landfill. The darkest councils score high on both. The two measures move together, but council type is tangled up with both.",
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "hconcat": [
    {
      "width": 740,
      "height": 420,
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "data/council_snapshot_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "Council",
              "group",
              "bivariate_class",
              "seifa_disadvantage",
              "lgprf_diversion_pct"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "bivariate_class",
          "type": "nominal",
          "scale": {
            "domain": [
              "low-low",
              "mid-low",
              "high-low",
              "low-mid",
              "mid-mid",
              "high-mid",
              "low-high",
              "mid-high",
              "high-high"
            ],
            "range": [
              "#e8e8e8",
              "#b8d6be",
              "#73ae80",
              "#b5c0da",
              "#90b2b3",
              "#5a9178",
              "#6c83b5",
              "#567994",
              "#2a5a5b"
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": "#111111"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": 2.6
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "seifa_disadvantage",
            "type": "quantitative",
            "format": ".0f",
            "title": "Advantage score (1000 = national average)"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Kept out of landfill (%)"
          }
        ]
      }
    },
    {
      "width": 118,
      "height": 118,
      "title": {
        "text": [
          "How to read the",
          "colours"
        ],
        "fontSize": 12,
        "anchor": "start",
        "dy": -4
      },
      "data": {
        "values": [
          {
            "sx": "low",
            "dy": "low",
            "c": "low-low"
          },
          {
            "sx": "low",
            "dy": "mid",
            "c": "low-mid"
          },
          {
            "sx": "low",
            "dy": "high",
            "c": "low-high"
          },
          {
            "sx": "mid",
            "dy": "low",
            "c": "mid-low"
          },
          {
            "sx": "mid",
            "dy": "mid",
            "c": "mid-mid"
          },
          {
            "sx": "mid",
            "dy": "high",
            "c": "mid-high"
          },
          {
            "sx": "high",
            "dy": "low",
            "c": "high-low"
          },
          {
            "sx": "high",
            "dy": "mid",
            "c": "high-mid"
          },
          {
            "sx": "high",
            "dy": "high",
            "c": "high-high"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "sx",
          "type": "ordinal",
          "sort": [
            "low",
            "mid",
            "high"
          ],
          "axis": {
            "title": "Better off \u2192",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11
          }
        },
        "y": {
          "field": "dy",
          "type": "ordinal",
          "sort": [
            "low",
            "mid",
            "high"
          ],
          "scale": {
            "reverse": true
          },
          "axis": {
            "title": "Keeps more out \u2192",
            "labels": false,
            "ticks": false,
            "domain": false,
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "c",
          "type": "nominal",
          "scale": {
            "domain": [
              "low-low",
              "mid-low",
              "high-low",
              "low-mid",
              "mid-mid",
              "high-mid",
              "low-high",
              "mid-high",
              "high-high"
            ],
            "range": [
              "#e8e8e8",
              "#b8d6be",
              "#73ae80",
              "#b5c0da",
              "#90b2b3",
              "#5a9178",
              "#6c83b5",
              "#567994",
              "#2a5a5b"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "c",
            "title": "Class"
          }
        ]
      }
    }
  ],
  "background": null
}
