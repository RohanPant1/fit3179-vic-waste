{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Mosaic plot of kerbside tonnage in 2023-24. Column width is each council type's share of the state total: metropolitan councils 44.5 per cent, small shires 2.8 per cent. Each column is split by waste stream, and garbage is between 44 and 54 per cent of every type.",
  "width": 450,
  "height": 300,
  "data": {
    "url": "data/mosaic_streams.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "(+datum.y0 + +datum.y1) / 2",
      "as": "ymid"
    },
    {
      "calculate": "+datum.y1 - +datum.y0",
      "as": "h"
    },
    {
      "calculate": "+datum.x1 - +datum.x0",
      "as": "w"
    },
    {
      "calculate": "{'Metro': 'Metropolitan', 'Interface': 'Interface', 'Regional City': 'Regional cities', 'Large Shire': 'Large shires', 'Small Shire': 'Small shires'}[datum.group]",
      "as": "label"
    }
  ],
  "encoding": {
    "x": {
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      }
    },
    "y": {
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1
        ],
        "reverse": true,
        "nice": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0"
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "Stream",
          "type": "nominal",
          "scale": {
            "domain": [
              "Garbage",
              "Mixed recycling",
              "Organics",
              "Glass"
            ],
            "range": [
              "#1F3A93",
              "#E69F00",
              "#009E73",
              "#CC79A7"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "offset": 10,
            "columnPadding": 14,
            "labelExpr": "datum.label === 'Organics' ? 'Food and garden' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Council type"
          },
          {
            "field": "Stream"
          },
          {
            "field": "tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Tonnes, 2023–24"
          },
          {
            "field": "stream_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "% of this type's waste"
          },
          {
            "field": "group_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "This type's % of state tonnes"
          }
        ]
      }
    },
    {
      "description": "Stream share written into each block that is big enough to hold it.",
      "transform": [
        {
          "filter": "datum.w > 0.05 && datum.h > 0.12"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {
          "field": "xmid"
        },
        "y": {
          "field": "ymid"
        },
        "text": {
          "field": "stream_share",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.Stream === 'Mixed recycling'",
            "value": "#14171A"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Stream === 'Garbage' && datum.group !== 'Small Shire'"
        },
        {
          "calculate": "{'Metro': ['Metropolitan'], 'Interface': ['Interface'], 'Regional City': ['Regional', 'cities'], 'Large Shire': ['Large', 'shires']}[datum.group]",
          "as": "name"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 8,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#14171A",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "xmid"
        },
        "y": {
          "datum": 1
        },
        "text": {
          "field": "name"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Stream === 'Garbage' && datum.group !== 'Small Shire'"
        },
        {
          "calculate": "format(datum.group_share, '.1f') + '%' + (datum.group === 'Metro' ? ' of state tonnes' : '')",
          "as": "share"
        },
        {
          "calculate": "datum.group === 'Regional City' || datum.group === 'Large Shire' ? 39 : 24",
          "as": "off"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "fontSize": 11.5,
        "color": "#5B6258"
      },
      "encoding": {
        "x": {
          "field": "xmid"
        },
        "y": {
          "datum": 1
        },
        "yOffset": {
          "field": "off",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "share"
        }
      }
    },
    {
      "description": "Small shires are 2.8% wide, too narrow for a label underneath, so they are labelled to the right with their garbage share.",
      "transform": [
        {
          "filter": "datum.Stream === 'Garbage' && datum.group === 'Small Shire'"
        },
        {
          "calculate": "['Small shires', format(datum.group_share, '.1f') + '% of tonnes', format(datum.stream_share, '.0f') + '% garbage']",
          "as": "lines"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "color": "#14171A",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "datum": 0.27
        },
        "text": {
          "field": "lines"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#14171A",
        "strokeWidth": 0.7
      },
      "encoding": {
        "x": {
          "datum": 0.9862
        },
        "x2": {
          "datum": 1.012
        },
        "y": {
          "datum": 0.27
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    }
  ],
  "background": null
}