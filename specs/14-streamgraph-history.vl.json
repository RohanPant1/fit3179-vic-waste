{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Streamgraph of Victorian kerbside tonnage by waste stream from 2001-02 to 2023-24, labelled directly. Garbage was 1.10 million tonnes in 2001-02 and 1.11 million in 2023-24. Food and garden grew from 111,000 to 718,000 tonnes and passed mixed recycling in 2020-21. Separate glass bins appear from 2019-20.",
  "width": 860,
  "height": 300,
  "data": {
    "url": "data/statewide_by_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "garbage_t",
        "recycling_t",
        "organics_t",
        "glass_t"
      ],
      "as": [
        "stream",
        "tonnes"
      ]
    },
    {
      "calculate": "toNumber(datum.tonnes)",
      "as": "tonnes"
    },
    {
      "calculate": "toNumber(datum.year_end)",
      "as": "yr"
    },
    {
      "calculate": "{'garbage_t': 'Garbage', 'recycling_t': 'Mixed recycling', 'organics_t': 'Food and garden', 'glass_t': 'Glass'}[datum.stream]",
      "as": "Stream"
    },
    {
      "calculate": "{'garbage_t': 0, 'recycling_t': 1, 'organics_t': 2, 'glass_t': 3}[datum.stream]",
      "as": "so"
    },
    {
      "stack": "tonnes",
      "groupby": [
        "yr"
      ],
      "sort": [
        {
          "field": "so",
          "order": "ascending"
        }
      ],
      "offset": "center",
      "as": [
        "y0",
        "y1"
      ]
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "ym"
    }
  ],
  "encoding": {
    "x": {
      "field": "yr",
      "type": "quantitative",
      "scale": {
        "domain": [
          2002,
          2024
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "values": [
          2002,
          2006,
          2010,
          2014,
          2018,
          2024
        ],
        "labelExpr": "(datum.value - 1) + '–' + substring(datum.value + '', 2)",
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#EEF0EA"
      }
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "zero": false
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pickStream",
          "select": {
            "type": "point",
            "fields": [
              "Stream"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "cursor": "pointer"
      },
      "encoding": {
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "Stream",
          "type": "nominal",
          "scale": {
            "domain": [
              "Garbage",
              "Mixed recycling",
              "Food and garden",
              "Glass"
            ],
            "range": [
              "#1F3A93",
              "#E69F00",
              "#009E73",
              "#CC79A7"
            ]
          },
          "legend": null
        },
        "detail": {
          "field": "Stream"
        },
        "order": {
          "field": "so"
        },
        "opacity": {
          "condition": {
            "param": "pickStream",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "financial_year",
            "title": "Year"
          },
          {
            "field": "Stream"
          },
          {
            "field": "tonnes",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Tonnes"
          }
        ]
      }
    },
    {
      "description": "Direct band labels, in place of a legend.",
      "transform": [
        {
          "filter": "datum.yr === 2009 && datum.Stream !== 'Glass'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 800
      },
      "encoding": {
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "Stream"
        },
        "color": {
          "condition": {
            "test": "datum.Stream === 'Mixed recycling'",
            "value": "#14171A"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "description": "The finding: garbage tonnes at each end.",
      "transform": [
        {
          "filter": "datum.Stream === 'Garbage' && (datum.yr === 2002 || datum.yr === 2024)"
        },
        {
          "calculate": "format(datum.tonnes / 1e6, '.2f') + ' Mt'",
          "as": "t"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.yr === 2002"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontSize": 12.5,
            "fontWeight": 800,
            "color": "#FFFFFF"
          },
          "encoding": {
            "y": {
              "field": "ym",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.yr === 2024"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "fontSize": 12.5,
            "fontWeight": 800,
            "color": "#FFFFFF"
          },
          "encoding": {
            "y": {
              "field": "ym",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Food and garden at each end.",
      "transform": [
        {
          "filter": "datum.Stream === 'Food and garden' && datum.yr === 2024"
        },
        {
          "calculate": "format(datum.tonnes / 1000, ',.0f') + ' kt'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12.5,
        "fontWeight": 800,
        "color": "#FFFFFF"
      },
      "encoding": {
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "When food and garden passed recycling.",
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              3,
              3
            ],
            "color": "#14171A",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "yr",
              "type": "quantitative"
            },
            "y": {
              "value": 0
            },
            "y2": {
              "value": 300
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -7,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#FFFFFF",
            "lineHeight": 15
          },
          "encoding": {
            "y": {
              "field": "ym",
              "type": "quantitative"
            },
            "text": {
              "value": [
                "2020–21: food and garden",
                "passes the yellow bin"
              ]
            }
          }
        }
      ],
      "transform": [
        {
          "filter": "datum.Stream === 'Food and garden' && datum.yr === 2021"
        }
      ]
    },
    {
      "description": "Glass is too thin to label inside, so its label sits just above the band's end.",
      "transform": [
        {
          "filter": "datum.Stream === 'Glass' && datum.yr === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#8E3F6B",
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "y1",
          "type": "quantitative"
        },
        "text": {
          "value": "Glass, from 2019–20"
        }
      }
    }
  ],
  "background": null
}