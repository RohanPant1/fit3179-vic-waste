{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "What a garbage bin costs, council by council",
    "subtitle": "Annual cost per kerbside garbage bin, 2024\u201325. Circle area is proportional to cost."
  },
  "width": 620,
  "height": 440,
  "layer": [
    {
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F0EC",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/council_snapshot_latest.csv"
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "garbage_cost_per_bin",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              50,
              320
            ],
            "range": [
              30,
              900
            ],
            "clamp": true
          },
          "legend": {
            "title": "$ per bin",
            "format": "$,.0f"
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Metro",
              "Interface",
              "Regional City",
              "Large Shire",
              "Small Shire"
            ],
            "range": [
              "#13496B",
              "#4F93C0",
              "#E8A33D",
              "#B5562A",
              "#6E5887"
            ]
          },
          "legend": {
            "title": "Council type"
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Type"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.2f",
            "title": "Cost per bin"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Diverted (%)"
          }
        ]
      }
    }
  ]
}
