{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dorling cartogram. Every Victorian council is a circle with area proportional to the kerbside waste it collects, nudged off its true location only far enough to stop circles overlapping, so the small metropolitan councils carry the same visual weight as the vast rural shires. The filled inner circle is the share kept out of landfill and the fill colour is the cost of a garbage bin.",
  "width": 860,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/vic_outline.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_outline"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EDEFE8",
        "stroke": "#D2D7CC",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "fill": "#FFFFFF",
        "fillOpacity": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "total_kerbside_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              140000
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": {
            "title": "Kerbside waste collected (tonnes)",
            "orient": "none",
            "legendX": 6,
            "legendY": 300,
            "values": [
              20000,
              60000,
              120000
            ],
            "format": ",.0f",
            "symbolFillColor": "#FFFFFF",
            "symbolStrokeColor": "#9AA195",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "total_kerbside_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Kerbside waste (tonnes)"
          },
          {
            "field": "diverted_share",
            "type": "quantitative",
            "format": ".0%",
            "title": "Share kept out of landfill"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per garbage bin"
          }
        ],
        "stroke": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": "#111111"
          },
          "value": "#9AA195"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": 2.8
          },
          "value": 1
        }
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "opacity": 0.95,
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "diverted_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              140000
            ],
            "range": [
              0,
              1700
            ]
          }
        },
        "color": {
          "field": "garbage_cost_per_bin",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              100,
              130,
              160,
              200,
              250
            ],
            "scheme": {
              "name": "plasma",
              "count": 6
            }
          },
          "legend": {
            "title": "Cost of a garbage bin, a year",
            "orient": "none",
            "legendX": 6,
            "legendY": 398,
            "direction": "horizontal",
            "gradientLength": 200,
            "format": "$,.0f",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "total_kerbside_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Kerbside waste (tonnes)"
          },
          {
            "field": "diverted_share",
            "type": "quantitative",
            "format": ".0%",
            "title": "Share kept out of landfill"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per garbage bin"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.total_kerbside_t > 90000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#14171A",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "strokeOpacity": 0.85,
        "fillOpacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "lga_name"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 141.0,
            "y": -34.3,
            "t": "Ring size is how much a council collects. The filled core is what it keeps out of landfill,"
          },
          {
            "x": 141.0,
            "y": -34.62,
            "t": "so a thin ring means most of it is buried. Colour is what a garbage bin costs."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11.5,
        "color": "#434A40"
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "background": null
}
