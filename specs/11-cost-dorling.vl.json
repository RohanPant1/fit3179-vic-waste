{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dorling cartogram. Every Victorian council is a circle with area proportional to the kerbside waste it collects in 2023-24, placed as near its real location as overlaps allow. Colour is the share kept out of landfill in 2024-25, on the same scale as the diversion map. Wyndham alone sends about 61,400 tonnes to landfill, as much as the ten lowest-scoring councils combined.",
  "width": 860,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/vic_outline.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_outline"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF0EA",
        "stroke": "#D2D7CC",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "datum.Council === focusCouncil ? 1 : 0",
          "as": "isFocus"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "total_kerbside_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              140000
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": {
            "title": "Kerbside waste collected, tonnes",
            "orient": "none",
            "legendX": 620,
            "legendY": 4,
            "direction": "horizontal",
            "values": [
              5000,
              40000,
              120000
            ],
            "format": ",.0f",
            "symbolFillColor": "#FFFFFF",
            "symbolStrokeColor": "#5B6258",
            "symbolStrokeWidth": 1,
            "titleLimit": 240
          }
        },
        "color": {
          "field": "lgprf_diversion_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              30,
              40,
              50,
              60
            ],
            "range": [
              "#CCECE6",
              "#99D8C9",
              "#66C2A4",
              "#2CA25F",
              "#006D2C"
            ]
          },
          "legend": {
            "title": "Share kept out of landfill",
            "orient": "none",
            "legendX": 620,
            "legendY": 92,
            "direction": "horizontal",
            "gradientLength": 200,
            "labelExpr": "isFinite(datum.value) ? datum.value + '%' : ''",
            "titleLimit": 240
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": "#111111"
          },
          "value": "#5B6258"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": 3
          },
          "value": 0.6
        },
        "order": {
          "field": "isFocus",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "total_kerbside_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Kerbside waste, tonnes (2023–24)"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "% kept out of landfill (2024–25)"
          }
        ]
      }
    },
    {
      "description": "The biggest councils by tonnes, labelled in place so readers can find their way without outlines.",
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "+datum.total_kerbside_t > 80000 && datum.lga_name !== 'Wyndham' && datum.lga_name !== 'Greater Geelong'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#14171A",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "dy": 0
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "lga_name"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "text": "Greater Geelong",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#14171A",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "align": "right"
      },
      "encoding": {
        "longitude": {
          "datum": 143.15
        },
        "latitude": {
          "datum": -38.0
        }
      }
    },
    {
      "description": "The lowest-diversion councils the text names, labelled beside their small circles.",
      "data": {
        "values": [
          {
            "x": 141.2841,
            "y": -36.782,
            "tx": 140.98,
            "ty": -37.2,
            "t": "West Wimmera 16%"
          },
          {
            "x": 142.3951,
            "y": -36.2064,
            "tx": 142.15,
            "ty": -35.55,
            "t": "Yarriambiack 17%"
          },
          {
            "x": 141.734,
            "y": -36.0611,
            "tx": 140.98,
            "ty": -35.75,
            "t": "Hindmarsh 23%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14171A",
            "strokeWidth": 0.6
          },
          "encoding": {
            "longitude": {
              "field": "x",
              "type": "quantitative"
            },
            "latitude": {
              "field": "y",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "tx"
            },
            "latitude2": {
              "field": "ty"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 3,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "longitude": {
              "field": "tx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ty",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "The finding: Wyndham's landfill tonnes against the ten lowest councils.",
      "data": {
        "values": [
          {
            "x": 144.18,
            "y": -38.2,
            "tx": 144.0,
            "ty": -38.95,
            "t": [
              "Wyndham 34%: 61,400 t to landfill,",
              "as much as the ten lowest councils combined"
            ]
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14171A",
            "strokeWidth": 0.7
          },
          "encoding": {
            "longitude": {
              "field": "x",
              "type": "quantitative"
            },
            "latitude": {
              "field": "y",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "tx"
            },
            "latitude2": {
              "field": "ty"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 4,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "lineHeight": 15
          },
          "encoding": {
            "longitude": {
              "field": "tx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ty",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Your council's name, when one is chosen.",
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.Council === focusCouncil"
        },
        {
          "calculate": "datum.Council + ' ' + format(datum.lgprf_diversion_pct, '.0f') + '%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 800,
        "color": "#111111",
        "stroke": "#FFFFFF",
        "strokeWidth": 3.5,
        "dy": -22
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "background": null
}