{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Flow map combined with proportional symbols. Green circles show organics processing sites in each council area, sized by how many there are (76 sites in 37 council areas, most around Melbourne and the regional cities). The 13 councils with no green bin are shaded, with a curved arrow from each to its nearest site, labelled with the straight-line distance. The western shires are 60 to 103 km from a site; Yarra, Murrindindi and Mansfield are within about 25 km.",
  "width": 860,
  "height": 470,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF0EA",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "description": "The 13 councils with no green bin, tinted by the bins they offer.",
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "data/no_green_bin_flows.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "Council",
              "km_to_organics",
              "service_label",
              "org_suburb"
            ]
          }
        },
        {
          "filter": "isValid(datum.Council)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "opacity": 0.3
      },
      "encoding": {
        "color": {
          "field": "service_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Garbage and recycling only",
              "Glass bin but no green bin"
            ],
            "range": [
              "#D55E00",
              "#CC79A7"
            ]
          },
          "legend": {
            "title": "Councils with no green bin",
            "orient": "none",
            "legendX": 640,
            "legendY": 4,
            "symbolType": "square",
            "symbolOpacity": 1,
            "titleLimit": 240
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": "#111111"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.Council === focusCouncil",
            "value": 2.4
          },
          "value": 0.7
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "service_label",
            "title": "Bins"
          },
          {
            "field": "km_to_organics",
            "type": "quantitative",
            "format": ".0f",
            "title": "km to nearest organics site"
          },
          {
            "field": "org_suburb",
            "title": "Nearest site"
          }
        ]
      }
    },
    {
      "description": "Organics processing sites, one circle per council area, sized by how many sites it holds.",
      "data": {
        "url": "data/facilities_by_lga.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "+datum.organics_plants > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#009E73",
        "opacity": 0.75,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "organics_plants",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              8
            ],
            "range": [
              0,
              420
            ]
          },
          "legend": {
            "title": "Organics sites in the area",
            "orient": "none",
            "legendX": 640,
            "legendY": 70,
            "direction": "horizontal",
            "values": [
              1,
              4,
              8
            ],
            "symbolFillColor": "#009E73",
            "symbolStrokeColor": "#FFFFFF",
            "titleLimit": 240
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "organics_plants",
            "type": "quantitative",
            "title": "Organics sites"
          }
        ]
      }
    },
    {
      "description": "Curved flows. Each flow is three points (origin, a control point offset to one side of the midpoint, the site) drawn as a B-spline, so flows bend away from each other and from other councils (Jenny et al. 2018).",
      "data": {
        "url": "data/no_green_bin_flows.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "+datum.org_lon - +datum.lon",
          "as": "dlon"
        },
        {
          "calculate": "+datum.org_lat - +datum.lat",
          "as": "dlat"
        },
        {
          "calculate": "(+datum.lon + +datum.org_lon) / 2 - datum.dlat * 0.3",
          "as": "clon"
        },
        {
          "calculate": "(+datum.lat + +datum.org_lat) / 2 + datum.dlon * 0.3",
          "as": "clat"
        },
        {
          "calculate": "[0, 1, 2]",
          "as": "k"
        },
        {
          "flatten": [
            "k"
          ]
        },
        {
          "calculate": "datum.k === 0 ? +datum.lon : datum.k === 1 ? datum.clon : +datum.org_lon",
          "as": "plon"
        },
        {
          "calculate": "datum.k === 0 ? +datum.lat : datum.k === 1 ? datum.clat : +datum.org_lat",
          "as": "plat"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "basis",
        "strokeWidth": 2.2,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        },
        "detail": {
          "field": "Council"
        },
        "order": {
          "field": "k"
        },
        "color": {
          "field": "service_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "km_to_organics",
            "type": "quantitative",
            "format": ".0f",
            "title": "km, straight line"
          },
          {
            "field": "org_name",
            "title": "Nearest organics site"
          },
          {
            "field": "org_suburb",
            "title": "In"
          }
        ]
      }
    },
    {
      "description": "Arrowheads at the site end, turned to the direction the flow arrives from.",
      "data": {
        "url": "data/no_green_bin_flows.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "(+datum.lon + +datum.org_lon) / 2 - (+datum.org_lat - +datum.lat) * 0.3",
          "as": "clon"
        },
        {
          "calculate": "(+datum.lat + +datum.org_lat) / 2 + (+datum.org_lon - +datum.lon) * 0.3",
          "as": "clat"
        },
        {
          "calculate": "atan2((+datum.org_lon - datum.clon) * cos(+datum.org_lat * PI / 180), +datum.org_lat - datum.clat) * 180 / PI",
          "as": "ang"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "org_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "org_lat",
          "type": "quantitative"
        },
        "angle": {
          "field": "ang",
          "type": "quantitative",
          "scale": null
        },
        "color": {
          "field": "service_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "org_name",
            "title": "Organics site"
          },
          {
            "field": "org_suburb",
            "title": "In"
          }
        ]
      }
    },
    {
      "description": "Council name and distance at the origin of each long or named trip.",
      "data": {
        "values": [
          {
            "lon": 141.39,
            "lat": -37.87,
            "t": "Glenelg 103 km",
            "a": "right"
          },
          {
            "lon": 141.73,
            "lat": -35.95,
            "t": "Hindmarsh 86 km",
            "a": "right"
          },
          {
            "lon": 141.28,
            "lat": -36.78,
            "t": "West Wimmera 80 km",
            "a": "right"
          },
          {
            "lon": 142.42,
            "lat": -35.68,
            "t": "Yarriambiack 62 km",
            "a": "right"
          },
          {
            "lon": 143.12,
            "lat": -35.62,
            "t": "Buloke 57 km",
            "a": "left"
          },
          {
            "lon": 146.9,
            "lat": -37.75,
            "t": "Wellington 52 km",
            "a": "left"
          },
          {
            "lon": 146.3,
            "lat": -36.98,
            "t": "Mansfield 23 km",
            "a": "left"
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.a === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -8,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.a === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 8,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Yarra is too small to label in place, so its label sits in the bay with a leader.",
      "data": {
        "values": [
          {
            "lon": 144.99,
            "lat": -37.8,
            "tx": 144.7,
            "ty": -38.75,
            "t": [
              "Yarra 12 km, but its nearest site",
              "is a grease-trap service"
            ]
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14171A",
            "strokeWidth": 0.7
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "tx"
            },
            "latitude2": {
              "field": "ty"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "size": 120,
            "filled": false,
            "stroke": "#14171A",
            "strokeWidth": 1.6
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "dy": 3,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "lineHeight": 15,
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "longitude": {
              "field": "tx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ty",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Murrindindi, labelled under its own short arrow.",
      "data": {
        "values": [
          {
            "lon": 145.66,
            "lat": -37.5,
            "t": "Murrindindi 15 km"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#14171A",
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "Key entry for the arrows, under the two legends.",
      "data": {
        "values": [
          {
            "lon": 148.2,
            "lat": -35.55,
            "t": "→  trip to the nearest organics site"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#D55E00"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "background": null
}