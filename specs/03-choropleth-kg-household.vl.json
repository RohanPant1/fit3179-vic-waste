{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Choropleth map of Victoria's 79 councils shaded by kilograms of kerbside material collected per household per year in 2023-24. Darker councils put out more. Peri-urban and holiday councils are heaviest.",
  "width": 470,
  "height": 400,
  "data": {
    "url": "data/vic_lga.topo.json",
    "format": {
      "type": "topojson",
      "feature": "vic_lga"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "transform": [
    {
      "lookup": "properties.lga_code",
      "from": {
        "data": {
          "url": "data/council_snapshot_latest.csv",
          "format": {
            "type": "csv",
            "parse": {
              "lga_code": "string"
            }
          }
        },
        "key": "lga_code",
        "fields": [
          "Council",
          "group",
          "kg_per_household",
          "kg_per_household_week"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "kg_per_household",
      "type": "quantitative",
      "scale": {
        "type": "threshold",
        "domain": [
          600,
          750,
          900,
          1050,
          1200
        ],
        "scheme": {
          "name": "viridis",
          "count": 6
        }
      },
      "legend": {
        "title": "Kilograms per household, a year",
        "orient": "none",
        "legendX": 0,
        "legendY": 346,
        "direction": "horizontal",
        "gradientLength": 180,
        "titleLimit": 300
      }
    },
    "stroke": {
      "condition": {
        "test": "datum.Council === focusCouncil",
        "value": "#111111"
      },
      "value": "#FFFFFF"
    },
    "strokeWidth": {
      "condition": {
        "test": "datum.Council === focusCouncil",
        "value": 2.4
      },
      "value": 0.5
    },
    "tooltip": [
      {
        "field": "Council"
      },
      {
        "field": "group",
        "title": "Council type"
      },
      {
        "field": "kg_per_household",
        "type": "quantitative",
        "format": ".0f",
        "title": "kg a year"
      },
      {
        "field": "kg_per_household_week",
        "type": "quantitative",
        "format": ".1f",
        "title": "kg a week"
      }
    ]
  },
  "background": null
}
