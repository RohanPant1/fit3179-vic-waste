{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": 880,
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/vic_outline.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_outline"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DFE2DA",
        "stroke": "#C3C8BD",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "stroke": "#8A9186",
        "strokeWidth": 1,
        "fill": "#FFFFFF",
        "fillOpacity": 0.55
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "total_kerbside_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              140000
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Council",
            "title": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "total_kerbside_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Kerbside waste (tonnes)"
          },
          {
            "field": "diverted_share",
            "type": "quantitative",
            "format": ".0%",
            "title": "Share kept out of landfill"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per bin"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "opacity": 0.95,
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "size": {
          "field": "diverted_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              140000
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": null
        },
        "color": {
          "field": "garbage_cost_per_bin",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              100,
              130,
              160,
              200,
              250
            ],
            "range": [
              "#2E6B3E",
              "#7FB539",
              "#D9CB4E",
              "#E3A008",
              "#D2622B",
              "#C8372D"
            ]
          },
          "legend": {
            "title": "Cost per bin",
            "orient": "right",
            "offset": 8,
            "format": "$.0f",
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Council",
            "title": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "total_kerbside_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Kerbside waste (tonnes)"
          },
          {
            "field": "diverted_share",
            "type": "quantitative",
            "format": ".0%",
            "title": "Share kept out of landfill"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per bin"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/council_dorling.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.total_kerbside_t > 85000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 9,
        "font": "IBM Plex Mono",
        "color": "#15181A",
        "opacity": 1,
        "dy": -3,
        "stroke": "#FFFFFF",
        "strokeWidth": 2.5,
        "fillOpacity": 1,
        "strokeOpacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "lga_name"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 141.0,
            "y": -34.25,
            "t": "Circle size is how much a council collects. The filled part is what it keeps out of landfill."
          },
          {
            "x": 141.0,
            "y": -34.58,
            "t": "A thin ring means most of it is buried. Colour is the cost of a garbage bin."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11.5,
        "color": "#3E453B",
        "font": "Source Serif 4"
      },
      "encoding": {
        "longitude": {
          "field": "x",
          "type": "quantitative"
        },
        "latitude": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
