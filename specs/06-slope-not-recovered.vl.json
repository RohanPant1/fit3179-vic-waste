{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 260,
  "height": 340,
  "data": {
    "url": "data/statewide_by_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year_end >= 2015"
    },
    {
      "filter": "datum.year_end == 2016 || datum.year_end == 2024"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#C8372D"
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "not_recovered_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              22
            ]
          },
          "title": "Not recovered (%)"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "color": "#C8372D"
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal"
        },
        "y": {
          "field": "not_recovered_pct",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 0,
        "dy": -16,
        "fontSize": 15,
        "fontWeight": 700,
        "color": "#C8372D"
      },
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "ordinal"
        },
        "y": {
          "field": "not_recovered_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "not_recovered_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "background": null
}
