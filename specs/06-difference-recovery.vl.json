{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Difference chart. The upper line is the tonnage Victorian councils collected in the yellow recycling bin each year from 2015-16 to 2023-24; the lower line is the tonnage sorting facilities recovered. The shaded gap is material collected but not recovered. It widens from 5.3 per cent of the stream to 18.7 per cent, about 94,000 tonnes in 2023-24.",
  "width": 740,
  "height": 290,
  "padding": {
    "top": 8,
    "left": 4,
    "right": 10,
    "bottom": 4
  },
  "data": {
    "url": "data/statewide_by_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year_end >= 2016"
    },
    {
      "calculate": "(+datum.year_end - 1) + '–' + substring(datum.year_end + '', 2)",
      "as": "fy"
    },
    {
      "calculate": "+datum.recycling_t - +datum.recycled_t",
      "as": "lost_t"
    }
  ],
  "encoding": {
    "x": {
      "field": "year_end",
      "type": "quantitative",
      "scale": {
        "domain": [
          2016,
          2024
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "values": [
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "labelExpr": "(datum.value - 1) + '–' + substring(datum.value + '', 2)",
        "domainColor": "#CFD4C8",
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#E69F00",
        "opacity": 0.28,
        "interpolate": "linear"
      },
      "encoding": {
        "y": {
          "field": "recycled_t",
          "type": "quantitative",
          "title": "Tonnes a year (axis starts at 350,000)",
          "scale": {
            "domain": [
              350000,
              650000
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": ",.0f",
            "values": [
              350000,
              400000,
              450000,
              500000,
              550000,
              600000,
              650000
            ],
            "grid": true,
            "gridColor": "#EEF0EA",
            "domain": false,
            "ticks": false
          }
        },
        "y2": {
          "field": "recycling_t"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#E69F00",
        "strokeWidth": 3,
        "interpolate": "linear",
        "point": {
          "filled": true,
          "size": 28,
          "color": "#E69F00"
        }
      },
      "encoding": {
        "y": {
          "field": "recycling_t",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#7A4E00",
        "strokeWidth": 3,
        "interpolate": "linear",
        "point": {
          "filled": true,
          "size": 28,
          "color": "#7A4E00"
        }
      },
      "encoding": {
        "y": {
          "field": "recycled_t",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Direct labels at the right-hand end of each line, in place of a legend.",
      "transform": [
        {
          "filter": "datum.year_end == 2024"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#9A6A00",
            "lineHeight": 15
          },
          "encoding": {
            "y": {
              "field": "recycling_t",
              "type": "quantitative"
            },
            "text": {
              "value": [
                "Put in the",
                "yellow-lid bin"
              ]
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#7A4E00",
            "lineHeight": 15
          },
          "encoding": {
            "y": {
              "field": "recycled_t",
              "type": "quantitative"
            },
            "text": {
              "value": [
                "Recovered by",
                "sorting facilities"
              ]
            }
          }
        }
      ]
    },
    {
      "description": "The gap at each end, labelled inside it.",
      "transform": [
        {
          "filter": "datum.year_end == 2016 || datum.year_end == 2024"
        },
        {
          "calculate": "datum.year_end == 2016 ? (+datum.recycling_t + +datum.recycled_t) / 2 : +datum.recycling_t - 23000",
          "as": "mid"
        },
        {
          "calculate": "datum.year_end == 2016 ? [format(datum.not_recovered_pct, '.1f') + '% not recovered'] : [format(datum.not_recovered_pct, '.1f') + '% not recovered,', 'about ' + format(round(datum.lost_t / 1000), ',') + ',000 t']",
          "as": "t"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.year_end == 2016"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "lineHeight": 15,
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "align": "left",
            "dx": 8
          },
          "encoding": {
            "y": {
              "field": "mid",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year_end == 2024"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#14171A",
            "lineHeight": 15,
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "align": "right",
            "dx": -8
          },
          "encoding": {
            "y": {
              "field": "mid",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 16,
        "opacity": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "fy",
            "title": "Year"
          },
          {
            "field": "recycling_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Put in the yellow bin, t"
          },
          {
            "field": "recycled_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Recovered, t"
          },
          {
            "field": "lost_t",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Not recovered, t"
          },
          {
            "field": "not_recovered_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Not recovered, %"
          }
        ]
      }
    }
  ],
  "background": null
}