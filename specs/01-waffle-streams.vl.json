{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 330,
  "height": 320,
  "data": {
    "url": "data/waffle_streams.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "square",
    "size": 680
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "reverse": false
      }
    },
    "color": {
      "field": "stream",
      "type": "nominal",
      "scale": {
        "domain": [
          "Garbage",
          "Mixed recycling",
          "Organics",
          "Glass"
        ],
        "range": [
          "#C8372D",
          "#E3A008",
          "#7FB539",
          "#7A52C7"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "stream",
        "title": "Stream"
      }
    ]
  },
  "background": null
}
