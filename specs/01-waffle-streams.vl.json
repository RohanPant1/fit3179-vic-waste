{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Waffle chart. One hundred squares, each one per cent of the 2.35 million tonnes Victorian councils collected at the kerb in 2023-24. Garbage fills 47 squares, food and garden waste 31, mixed recycling 21 and glass 1.",
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/waffle_streams.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "pick",
      "select": {
        "type": "point",
        "fields": [
          "stream"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "square",
    "size": 620,
    "stroke": "#FFFFFF",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "stream",
      "type": "nominal",
      "scale": {
        "domain": [
          "Garbage",
          "Mixed recycling",
          "Organics",
          "Glass"
        ],
        "range": [
          "#1F3A93",
          "#E69F00",
          "#009E73",
          "#CC79A7"
        ]
      },
      "legend": {
        "title": "One square = 1% of what Victoria collects",
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "symbolType": "square",
        "symbolSize": 150,
        "offset": 10,
        "titleLimit": 400,
        "labelExpr": "{'Garbage': 'Garbage 47%', 'Organics': 'Food and garden 31%', 'Mixed recycling': 'Mixed recycling 21%', 'Glass': 'Glass 0.7%'}[datum.label] || datum.label"
      }
    },
    "opacity": {
      "condition": {
        "param": "pick",
        "value": 1
      },
      "value": 0.18
    },
    "tooltip": [
      {
        "field": "stream",
        "title": "Stream"
      }
    ]
  },
  "background": null
}