{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Strip plot. Each vertical tick is one Victorian council, placed along the 2021 census index of disadvantage, where 1000 is the national average. The upper row is the 66 councils with a kerbside green bin and the lower row the 13 without. The 13 are spread across the whole range rather than bunched at the disadvantaged end, so missing out on a green bin does not track wealth.",
  "width": 760,
  "height": 130,
  "data": {
    "url": "data/council_snapshot_latest.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "transform": [
    {
      "calculate": "datum.has_organics === 'True' || datum.has_organics === true ? 'Has a green bin' : 'No green bin'",
      "as": "svc"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "n"
        },
        {
          "op": "median",
          "field": "seifa_disadvantage",
          "as": "med"
        }
      ],
      "groupby": [
        "svc"
      ]
    },
    {
      "calculate": "datum.svc + '  (' + datum.n + ' councils)'",
      "as": "rowlab"
    }
  ],
  "encoding": {
    "y": {
      "field": "rowlab",
      "type": "nominal",
      "sort": [
        "Has a green bin  (66 councils)",
        "No green bin  (13 councils)"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12.5,
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "labelPadding": 10,
        "labelLimit": 220
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "tick",
        "thickness": 2.2,
        "size": 40,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "seifa_disadvantage",
          "type": "quantitative",
          "scale": {
            "domain": [
              870,
              1110
            ],
            "nice": false
          },
          "title": "More disadvantaged  \u2190    census index of disadvantage, 1000 = national average    \u2192  better off"
        },
        "color": {
          "field": "svc",
          "type": "nominal",
          "scale": {
            "domain": [
              "Has a green bin",
              "No green bin"
            ],
            "range": [
              "#009E73",
              "#D55E00"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-right",
            "offset": 2,
            "symbolType": "stroke",
            "symbolStrokeWidth": 3
          }
        },
        "opacity": {
          "condition": {
            "test": "focusCouncil === '' || datum.Council === focusCouncil",
            "value": 0.9
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Council type"
          },
          {
            "field": "service_label",
            "title": "Bins"
          },
          {
            "field": "seifa_disadvantage",
            "type": "quantitative",
            "format": ".0f",
            "title": "Index score"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Kept out of landfill (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "tick",
        "thickness": 2,
        "size": 56,
        "color": "#14171A",
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "med",
          "type": "quantitative",
          "aggregate": "min"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "fontWeight": 700,
        "color": "#14171A",
        "dy": -34,
        "align": "center",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "strokeOpacity": 0.9,
        "fillOpacity": 1
      },
      "encoding": {
        "x": {
          "field": "med",
          "type": "quantitative",
          "aggregate": "min"
        },
        "text": {
          "field": "med",
          "type": "quantitative",
          "aggregate": "min",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Council === focusCouncil"
        }
      ],
      "mark": {
        "type": "tick",
        "thickness": 3.4,
        "size": 48,
        "color": "#111111"
      },
      "encoding": {
        "x": {
          "field": "seifa_disadvantage",
          "type": "quantitative"
        }
      }
    }
  ],
  "background": null
}
