{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Unit butterfly chart. Rows are 25-point bands of the 2021 census disadvantage score, higher meaning better off. Each square is one council: the 13 with no green bin build to the left, the 66 with one to the right, coloured by the bins they offer. The 13 sit between 925 and 1050, with a median of 991 against 1003 for councils with a green bin and a national average of 1000.",
  "width": 500,
  "height": 290,
  "data": {
    "url": "data/council_snapshot_latest.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(datum.seifa_disadvantage)",
      "as": "seifa"
    },
    {
      "calculate": "floor(datum.seifa / 25) * 25",
      "as": "band"
    },
    {
      "calculate": "datum.has_organics === 'True' ? 'right' : 'left'",
      "as": "side"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "i"
        }
      ],
      "groupby": [
        "band",
        "side"
      ],
      "sort": [
        {
          "field": "seifa",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.side === 'left' ? -(datum.i - 0.5) - 0.6 : (datum.i - 0.5) + 0.6",
      "as": "x"
    },
    {
      "calculate": "datum.band + 12.5",
      "as": "y"
    }
  ],
  "encoding": {
    "y": {
      "field": "y",
      "type": "quantitative",
      "scale": {
        "domain": [
          875,
          1100
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Census disadvantage score, 2021 (higher is better off)",
        "values": [
          875,
          900,
          925,
          950,
          975,
          1000,
          1025,
          1050,
          1075,
          1100
        ],
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#EEF0EA",
        "titleFontWeight": 600
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#14171A",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -6.6,
              17.5
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "datum": 875
        },
        "y2": {
          "datum": 1100
        }
      }
    },
    {
      "description": "One square per council.",
      "mark": {
        "type": "square",
        "size": 170,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "color": {
          "field": "service_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Garbage and recycling only",
              "Glass bin but no green bin",
              "Green bin, no glass",
              "All four bins"
            ],
            "range": [
              "#D55E00",
              "#CC79A7",
              "#56B4E9",
              "#0072B2"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "square",
            "offset": 10
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "seifa",
            "type": "quantitative",
            "title": "Disadvantage score (1000 = national average)"
          },
          {
            "field": "service_label",
            "title": "Bins"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Council === focusCouncil"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "square",
            "size": 330,
            "filled": false,
            "stroke": "#111111",
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 14,
            "fontSize": 12,
            "fontWeight": 800,
            "color": "#111111",
            "stroke": "#FFFFFF",
            "strokeWidth": 3.5
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "text": {
              "field": "Council"
            }
          }
        }
      ]
    },
    {
      "description": "Medians and the national average.",
      "data": {
        "values": [
          {
            "x1": -6.6,
            "x2": 0,
            "y": 991,
            "t": "median 991",
            "side": "left"
          },
          {
            "x1": 0,
            "x2": 14.5,
            "y": 1003,
            "t": "median 1003",
            "side": "right"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#14171A",
            "strokeWidth": 1.4,
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "x": {
              "field": "x1",
              "type": "quantitative"
            },
            "x2": {
              "field": "x2"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dy": -3,
            "fontSize": 11.5,
            "fontWeight": 700,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "x1",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": 0,
            "fontSize": 11.5,
            "fontWeight": 700,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "dx": 6
          },
          "encoding": {
            "x": {
              "field": "x2",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "description": "Side headings.",
      "data": {
        "values": [
          {
            "x": -0.6,
            "t": "No green bin (13)",
            "a": "right",
            "y": 1100
          },
          {
            "x": 0.6,
            "t": "Green bin (66)",
            "a": "left",
            "y": 1100
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.a === 'right'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 12.5,
            "fontWeight": 800,
            "color": "#14171A"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.a === 'left'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 12.5,
            "fontWeight": 800,
            "color": "#14171A"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ],
  "background": null,
  "padding": {
    "top": 22,
    "left": 4,
    "right": 4,
    "bottom": 4
  }
}