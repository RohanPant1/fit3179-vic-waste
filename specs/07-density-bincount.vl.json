{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 620,
  "height": 260,
  "data": {
    "url": "data/council_snapshot_latest.csv"
  },
  "transform": [
    {
      "calculate": "datum.streams == 2 ? '2 bins (garbage + recycling)' : datum.streams == 3 ? '3 bins (+ organics)' : '4 bins (+ glass)'",
      "as": "bins"
    },
    {
      "density": "lgprf_diversion_pct",
      "groupby": [
        "bins"
      ],
      "extent": [
        5,
        85
      ],
      "bandwidth": 6,
      "as": [
        "dx",
        "dy"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.55,
        "line": {
          "strokeWidth": 2
        }
      },
      "encoding": {
        "x": {
          "field": "dx",
          "type": "quantitative",
          "scale": {
            "domain": [
              5,
              85
            ]
          },
          "title": "Diverted from landfill (%)"
        },
        "y": {
          "field": "dy",
          "type": "quantitative",
          "stack": null,
          "axis": null,
          "title": null
        },
        "color": {
          "field": "bins",
          "type": "nominal",
          "scale": {
            "domain": [
              "2 bins (garbage + recycling)",
              "3 bins (+ organics)",
              "4 bins (+ glass)"
            ],
            "range": [
              "#C8372D",
              "#7FB539",
              "#1F5F4B"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "offset": 4,
            "labelLimit": 300,
            "padding": 0,
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "bins",
            "title": "Service"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/council_snapshot_latest.csv"
      },
      "transform": [
        {
          "calculate": "datum.streams == 2 ? '2 bins (garbage + recycling)' : datum.streams == 3 ? '3 bins (+ organics)' : '4 bins (+ glass)'",
          "as": "bins"
        },
        {
          "aggregate": [
            {
              "op": "median",
              "field": "lgprf_diversion_pct",
              "as": "m"
            }
          ],
          "groupby": [
            "bins"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "m",
          "type": "quantitative"
        },
        "color": {
          "field": "bins",
          "type": "nominal",
          "scale": {
            "domain": [
              "2 bins (garbage + recycling)",
              "3 bins (+ organics)",
              "4 bins (+ glass)"
            ],
            "range": [
              "#C8372D",
              "#7FB539",
              "#1F5F4B"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 30.6,
            "t": "median 31%"
          },
          {
            "x": 52.3,
            "t": "median 52%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1A1A1A",
        "baseline": "top",
        "dy": 2,
        "dx": 4,
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "y": {
          "value": 0
        }
      }
    }
  ],
  "background": null
}
