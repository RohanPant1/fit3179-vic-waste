{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Heatmap counting Victoria's 79 councils. Rows are the bins a council offers; columns are five-point bands of the share of kerbside waste kept out of landfill in 2024-25. The number in each square is how many councils fall in that band, and darker squares hold more councils. The median rises from 30.6 per cent with two bins to 53.8 per cent with a green bin, then sits at 52.4 per cent with a glass bin added as well.",
  "width": 640,
  "height": 290,
  "padding": {
    "top": 30,
    "left": 4,
    "right": 6,
    "bottom": 4
  },
  "data": {
    "url": "data/council_snapshot_latest.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "focusCouncil",
      "value": ""
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(datum.lgprf_diversion_pct)",
      "as": "div"
    },
    {
      "calculate": "floor(datum.div / 5) * 5",
      "as": "b0"
    },
    {
      "calculate": "datum.b0 + 5",
      "as": "b1"
    },
    {
      "calculate": "indexof(['Garbage and recycling only', 'Glass bin but no green bin', 'Green bin, no glass', 'All four bins'], datum.service_label)",
      "as": "svcOrder"
    },
    {
      "calculate": "datum.b0 + 2.5",
      "as": "bm"
    }
  ],
  "encoding": {
    "y": {
      "field": "service_label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Garbage and recycling only",
          "Glass bin but no green bin",
          "Green bin, no glass",
          "All four bins"
        ],
        "paddingInner": 0.14
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelPadding": 10,
        "labelFontSize": 12.5,
        "labelFontWeight": 700,
        "labelColor": "#14171A",
        "labelLimit": 200,
        "labelExpr": "{'Garbage and recycling only': ['Garbage and', 'recycling only (10)'], 'Glass bin but no green bin': ['Glass bin, no', 'green bin (3)'], 'Green bin, no glass': ['Green bin,', 'no glass (53)'], 'All four bins': ['All four', 'bins (13)']}[datum.value]"
      }
    }
  },
  "layer": [
    {
      "description": "Pale track behind each row, so empty bands read as empty rather than missing.",
      "mark": {
        "type": "rect",
        "color": "#F1F3EE"
      },
      "encoding": {
        "x": {
          "datum": 10,
          "type": "quantitative",
          "scale": {
            "domain": [
              10,
              80
            ],
            "nice": false
          },
          "axis": {
            "title": "Share of kerbside waste kept out of landfill, 2024–25",
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70,
              80
            ],
            "labelExpr": "datum.value + '%'",
            "domain": false,
            "ticks": false,
            "grid": false
          }
        },
        "x2": {
          "datum": 80
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "values",
              "as": "rows"
            }
          ],
          "groupby": [
            "service_label",
            "svcOrder",
            "b0",
            "b1",
            "bm"
          ]
        },
        {
          "calculate": "join(pluck(datum.rows, 'Council'), ', ')",
          "as": "names"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "#FFFFFF",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "b0",
              "type": "quantitative"
            },
            "x2": {
              "field": "b1"
            },
            "color": {
              "field": "service_label",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Garbage and recycling only",
                  "Glass bin but no green bin",
                  "Green bin, no glass",
                  "All four bins"
                ],
                "range": [
                  "#D55E00",
                  "#CC79A7",
                  "#56B4E9",
                  "#0072B2"
                ]
              },
              "legend": null
            },
            "opacity": {
              "field": "n",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  8
                ],
                "range": [
                  0.28,
                  1
                ]
              },
              "legend": {
                "title": "Number of councils in a square (79 councils in total)",
                "orient": "top",
                "direction": "horizontal",
                "values": [
                  1,
                  4,
                  8
                ],
                "symbolType": "square",
                "symbolSize": 260,
                "symbolFillColor": "#56B4E9",
                "symbolStrokeWidth": 0,
                "titleLimit": 420,
                "offset": 20,
                "labelFontSize": 12
              }
            },
            "tooltip": [
              {
                "field": "service_label",
                "title": "Bins"
              },
              {
                "field": "b0",
                "type": "quantitative",
                "title": "From (%)"
              },
              {
                "field": "b1",
                "type": "quantitative",
                "title": "To (%)"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Councils"
              },
              {
                "field": "names",
                "title": "Which"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12.5,
            "fontWeight": 800
          },
          "encoding": {
            "x": {
              "field": "bm",
              "type": "quantitative"
            },
            "text": {
              "field": "n",
              "type": "quantitative"
            },
            "color": {
              "condition": {
                "test": "datum.n >= 4",
                "value": "#FFFFFF"
              },
              "value": "#14171A"
            }
          }
        }
      ]
    },
    {
      "description": "Row medians.",
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "div",
              "as": "med"
            }
          ],
          "groupby": [
            "service_label"
          ]
        },
        {
          "calculate": "'median ' + format(datum.med, '.1f') + '%'",
          "as": "medlab"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "triangle-down",
            "filled": true,
            "size": 90,
            "color": "#14171A"
          },
          "encoding": {
            "x": {
              "field": "med",
              "type": "quantitative"
            },
            "y": {
              "field": "service_label",
              "type": "nominal",
              "bandPosition": 0
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 7,
            "fontSize": 11.5,
            "fontWeight": 800,
            "color": "#14171A",
            "stroke": "#FFFFFF",
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "med",
              "type": "quantitative"
            },
            "y": {
              "field": "service_label",
              "type": "nominal",
              "bandPosition": 0
            },
            "yOffset": {
              "value": -1
            },
            "text": {
              "field": "medlab"
            }
          }
        }
      ]
    },
    {
      "description": "The three councils with a glass bin but no green bin, named on their row.",
      "data": {
        "values": [
          {
            "service_label": "Glass bin but no green bin",
            "x": 46,
            "t": "Yarriambiack 17%, Hindmarsh 23%, Yarra 42%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#14171A"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "The step the section is about.",
      "data": {
        "values": [
          {
            "x": 80,
            "y": "Green bin, no glass",
            "t": [
              "+23 points with",
              "a green bin"
            ]
          },
          {
            "x": 80,
            "y": "All four bins",
            "t": [
              "−1 point with a",
              "glass bin on top"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 800,
        "color": "#14171A",
        "lineHeight": 14,
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "nominal"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "description": "Your council's cell, ringed.",
      "transform": [
        {
          "filter": "datum.Council === focusCouncil"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "filled": false,
            "stroke": "#111111",
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "field": "b0",
              "type": "quantitative"
            },
            "x2": {
              "field": "b1"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -26,
            "fontSize": 12,
            "fontWeight": 800,
            "color": "#111111",
            "stroke": "#FFFFFF",
            "strokeWidth": 3.5
          },
          "encoding": {
            "x": {
              "field": "div",
              "type": "quantitative"
            },
            "text": {
              "field": "Council"
            }
          }
        }
      ]
    }
  ],
  "background": null
}