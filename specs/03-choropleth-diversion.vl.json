{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Half of Victoria's kerbside waste never reaches landfill",
    "subtitle": "Share of kerbside collection diverted from landfill, by council, 2024–25",
    "subtitleFontSize": 13
  },
  "hconcat": [
    {
      "width": 620,
      "height": 460,
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "data/council_snapshot_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "Council",
              "group",
              "lgprf_diversion_pct",
              "garbage_cost_per_bin"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "lgprf_diversion_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              30,
              40,
              50,
              60,
              70
            ],
            "range": [
              "#e5f5e0",
              "#c7e9c0",
              "#a1d99b",
              "#74c476",
              "#31a354",
              "#006d2c"
            ]
          },
          "legend": {
            "title": [
              "Diverted from",
              "landfill (%)"
            ],
            "orient": "right",
            "offset": 4
          }
        },
        "tooltip": [
          {
            "field": "Council",
            "title": "Council"
          },
          {
            "field": "group",
            "title": "Type"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Diverted (%)"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per bin"
          }
        ]
      }
    },
    {
      "width": 250,
      "height": 250,
      "title": {
        "text": "Metropolitan Melbourne",
        "fontSize": 13,
        "subtitle": null
      },
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "data/council_snapshot_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "Council",
              "group",
              "lgprf_diversion_pct",
              "garbage_cost_per_bin"
            ]
          }
        },
        {
          "filter": "datum.group === 'Metro'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "lgprf_diversion_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              30,
              40,
              50,
              60,
              70
            ],
            "range": [
              "#e5f5e0",
              "#c7e9c0",
              "#a1d99b",
              "#74c476",
              "#31a354",
              "#006d2c"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Council",
            "title": "Council"
          },
          {
            "field": "group",
            "title": "Type"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Diverted (%)"
          },
          {
            "field": "garbage_cost_per_bin",
            "type": "quantitative",
            "format": "$.0f",
            "title": "Cost per bin"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}
