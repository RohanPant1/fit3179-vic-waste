{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 980,
  "height": 440,
  "layer": [
    {
      "data": {
        "url": "data/vic_lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "vic_lga"
        }
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "data/council_snapshot_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "Council",
              "group",
              "has_organics",
              "lgprf_diversion_pct"
            ]
          }
        },
        {
          "calculate": "datum.has_organics == 'True' || datum.has_organics === true ? 'Has a green bin' : 'No green bin'",
          "as": "green"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "green",
          "type": "nominal",
          "scale": {
            "domain": [
              "No green bin",
              "Has a green bin"
            ],
            "range": [
              "#C8372D",
              "#DCE6DC"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "offset": 4,
            "labelLimit": 300,
            "padding": 0,
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Council"
          },
          {
            "field": "group",
            "title": "Type"
          },
          {
            "field": "lgprf_diversion_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Diverted (%)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/council_snapshot_latest.csv"
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "transform": [
        {
          "filter": "datum.has_organics == 'False' || datum.has_organics === false"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontWeight": 600,
        "color": "#1A1A1A",
        "dy": -7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Council"
        }
      }
    }
  ],
  "background": null
}
