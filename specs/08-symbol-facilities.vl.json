{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional symbol map. A circle in each council area sized by the number of organics processing sites inside it, March 2025: 76 sites across 37 of the 79 council areas, most around Melbourne and the regional cities. The 13 councils with no green bin are shaded by the bins they do offer; eight of them contain no organics site.",
  "width": 590,
  "height": 370,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-36, -38],
    "rotate": [-145, 0, 0]
  },
  "params": [{"name": "focusCouncil", "value": ""}],
  "layer": [
    {
      "data": {"url": "data/vic_lga.topo.json", "format": {"type": "topojson", "feature": "vic_lga"}},
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {"url": "data/council_snapshot_latest.csv", "format": {"type": "csv", "parse": {"lga_code": "string"}}},
            "key": "lga_code",
            "fields": ["Council", "service_label", "has_organics", "km_to_organics"]
          }
        },
        {"calculate": "datum.has_organics === 'True' ? 'Has a green bin' : datum.service_label", "as": "shade"}
      ],
      "mark": {"type": "geoshape", "strokeWidth": 0.6},
      "encoding": {
        "color": {
          "field": "shade",
          "type": "nominal",
          "scale": {
            "domain": ["Garbage and recycling only", "Glass bin but no green bin", "Has a green bin"],
            "range": ["#D55E00", "#CC79A7", "#EEF0EA"]
          },
          "legend": {
            "title": "No green bin: what the council offers",
            "orient": "none",
            "legendX": 380,
            "legendY": 4,
            "values": ["Garbage and recycling only", "Glass bin but no green bin"],
            "symbolType": "square",
            "titleLimit": 260
          }
        },
        "opacity": {"condition": {"test": "datum.shade === 'Has a green bin'", "value": 1}, "value": 0.55},
        "stroke": {"condition": {"test": "datum.Council === focusCouncil", "value": "#111111"}, "value": "#FFFFFF"},
        "strokeWidth": {"condition": {"test": "datum.Council === focusCouncil", "value": 2.4}, "value": 0.6},
        "tooltip": [
          {"field": "Council"},
          {"field": "service_label", "title": "Bins"},
          {"field": "km_to_organics", "type": "quantitative", "format": ".0f", "title": "km to nearest organics site"}
        ]
      }
    },
    {
      "data": {"url": "data/facilities_by_lga.csv", "format": {"type": "csv"}},
      "transform": [{"filter": "+datum.organics_plants > 0"}],
      "mark": {"type": "circle", "color": "#009E73", "opacity": 0.85, "stroke": "#FFFFFF", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "organics_plants",
          "type": "quantitative",
          "scale": {"type": "linear", "domain": [0, 8], "range": [0, 520]},
          "legend": {
            "title": "Organics sites in the council area",
            "orient": "none",
            "legendX": 380,
            "legendY": 66,
            "direction": "horizontal",
            "values": [1, 4, 8],
            "symbolFillColor": "#009E73",
            "symbolStrokeColor": "#FFFFFF",
            "titleLimit": 260
          }
        },
        "tooltip": [
          {"field": "Council"},
          {"field": "organics_plants", "type": "quantitative", "title": "Organics sites"},
          {"field": "facilities", "type": "quantitative", "title": "All waste facilities"}
        ]
      }
    },
    {
      "description": "The councils the note names.",
      "data": {
        "values": [
          {"lon": 145.19, "lat": -38.01, "tx": 145.85, "ty": -38.75, "t": "Greater Dandenong 8", "a": "left"},
          {"lon": 144.37, "lat": -37.97, "tx": 143.6, "ty": -38.75, "t": "Greater Geelong 5", "a": "right"},
          {"lon": 146.44, "lat": -38.28, "tx": 147.35, "ty": -38.45, "t": "Latrobe 5", "a": "left"},
          {"lon": 141.39, "lat": -37.87, "tx": 141.3, "ty": -38.45, "t": "Glenelg 0", "a": "left"}
        ]
      },
      "layer": [
        {
          "mark": {"type": "rule", "color": "#14171A", "strokeWidth": 0.6},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude2": {"field": "tx"},
            "latitude2": {"field": "ty"}
          }
        },
        {
          "transform": [{"filter": "datum.a === 'left'"}],
          "mark": {"type": "text", "align": "left", "baseline": "top", "dy": 2, "fontSize": 12, "fontWeight": 600, "color": "#14171A", "stroke": "#FFFFFF", "strokeWidth": 3},
          "encoding": {"longitude": {"field": "tx", "type": "quantitative"}, "latitude": {"field": "ty", "type": "quantitative"}, "text": {"field": "t"}}
        },
        {
          "transform": [{"filter": "datum.a === 'right'"}],
          "mark": {"type": "text", "align": "right", "baseline": "top", "dy": 2, "fontSize": 12, "fontWeight": 600, "color": "#14171A", "stroke": "#FFFFFF", "strokeWidth": 3},
          "encoding": {"longitude": {"field": "tx", "type": "quantitative"}, "latitude": {"field": "ty", "type": "quantitative"}, "text": {"field": "t"}}
        }
      ]
    }
  ],
  "background": null
}
