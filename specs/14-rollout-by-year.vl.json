{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2016,
        "max": 2024,
        "step": 1,
        "name": "Financial year ending  "
      }
    }
  ],
  "vconcat": [
    {
      "width": 820,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "data": {
        "url": "data/rollout_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year_end": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_end == year"
        },
        {
          "lookup": "lga_code",
          "from": {
            "data": {
              "url": "data/vic_lga.topo.json",
              "format": {
                "type": "topojson",
                "feature": "vic_lga"
              }
            },
            "key": "properties.lga_code"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "service",
          "type": "nominal",
          "scale": {
            "domain": [
              "No green bin",
              "Garden only",
              "Food and garden",
              "Food, garden and glass"
            ],
            "range": [
              "#C8372D",
              "#CBDCAC",
              "#7FB539",
              "#7A52C7"
            ]
          },
          "sort": [
            "No green bin",
            "Garden only",
            "Food and garden",
            "Food, garden and glass"
          ],
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "offset": 2,
            "labelFontSize": 11.5,
            "labelLimit": 220,
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "council",
            "title": "Council"
          },
          {
            "field": "service",
            "title": "Kerbside service"
          },
          {
            "field": "year_end",
            "type": "quantitative",
            "title": "Year ending",
            "format": "d"
          }
        ]
      }
    },
    {
      "width": 820,
      "height": 120,
      "data": {
        "url": "data/rollout_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year_end": "number"
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                }
              ],
              "groupby": [
                "year_end",
                "service"
              ]
            }
          ],
          "mark": {
            "type": "area",
            "interpolate": "monotone",
            "opacity": 0.95
          },
          "encoding": {
            "x": {
              "field": "year_end",
              "type": "quantitative",
              "title": null,
              "axis": {
                "format": "d",
                "tickCount": 9,
                "labelFontSize": 11
              },
              "scale": {
                "domain": [
                  2016,
                  2024
                ],
                "nice": false
              }
            },
            "y": {
              "field": "n",
              "type": "quantitative",
              "stack": "zero",
              "title": "Councils",
              "axis": {
                "tickCount": 3,
                "labelFontSize": 11
              }
            },
            "color": {
              "field": "service",
              "type": "nominal",
              "scale": {
                "domain": [
                  "No green bin",
                  "Garden only",
                  "Food and garden",
                  "Food, garden and glass"
                ],
                "range": [
                  "#C8372D",
                  "#CBDCAC",
                  "#7FB539",
                  "#7A52C7"
                ]
              },
              "sort": [
                "No green bin",
                "Garden only",
                "Food and garden",
                "Food, garden and glass"
              ],
              "legend": null
            },
            "order": {
              "field": "service",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "year_end",
                "type": "quantitative",
                "title": "Year ending",
                "format": "d"
              },
              {
                "field": "service",
                "title": "Kerbside service"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Councils"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#15181A",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "datum": {
                "expr": "year"
              },
              "type": "quantitative",
              "scale": {
                "domain": [
                  2016,
                  2024
                ],
                "nice": false
              }
            }
          }
        }
      ]
    }
  ],
  "spacing": 14
}
