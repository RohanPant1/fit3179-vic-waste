{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "An interactive map with a year slider, above a band chart of the same nine years. It shows what kerbside organics service each Victorian council ran between 2015-16 and 2023-24. Few councils gained a green bin outright; the larger change is garden-only bins beginning to accept food scraps, which went from 3 councils to 55.",
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2016,
        "max": 2024,
        "step": 1,
        "name": "Year ending June "
      }
    }
  ],
  "vconcat": [
    {
      "width": 560,
      "height": 320,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -36,
          -38
        ],
        "rotate": [
          -145,
          0,
          0
        ]
      },
      "data": {
        "url": "data/rollout_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year_end": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_end == year"
        },
        {
          "lookup": "lga_code",
          "from": {
            "data": {
              "url": "data/vic_lga.topo.json",
              "format": {
                "type": "topojson",
                "feature": "vic_lga"
              }
            },
            "key": "properties.lga_code"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "service",
          "type": "nominal",
          "scale": {
            "domain": [
              "No green bin",
              "Garden only",
              "Food and garden",
              "Food, garden and glass"
            ],
            "range": [
              "#D55E00",
              "#A6D5F2",
              "#56B4E9",
              "#0072B2"
            ]
          },
          "sort": [
            "No green bin",
            "Garden only",
            "Food and garden",
            "Food, garden and glass"
          ],
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "offset": 2,
            "labelFontSize": 12,
            "labelLimit": 220,
            "columns": 4,
            "symbolType": "square",
            "symbolSize": 130
          }
        },
        "tooltip": [
          {
            "field": "council",
            "title": "Council"
          },
          {
            "field": "service",
            "title": "Kerbside service"
          },
          {
            "field": "year_end",
            "type": "quantitative",
            "title": "Year ending",
            "format": "d"
          }
        ]
      }
    },
    {
      "width": 560,
      "height": 120,
      "data": {
        "url": "data/rollout_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year_end": "number"
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                }
              ],
              "groupby": [
                "year_end",
                "service"
              ]
            },
            {
              "impute": "n",
              "key": "year_end",
              "groupby": [
                "service"
              ],
              "value": 0
            },
            {
              "calculate": "indexof(['No green bin', 'Garden only', 'Food and garden', 'Food, garden and glass'], datum.service)",
              "as": "so"
            },
            {
              "stack": "n",
              "groupby": [
                "year_end"
              ],
              "sort": [
                {
                  "field": "so",
                  "order": "ascending"
                }
              ],
              "as": [
                "s0",
                "s1"
              ]
            },
            {
              "calculate": "(datum.s0 + datum.s1) / 2",
              "as": "sm"
            }
          ],
          "mark": {
            "type": "area",
            "interpolate": "linear"
          },
          "encoding": {
            "x": {
              "field": "year_end",
              "type": "quantitative",
              "title": null,
              "axis": {
                "title": null,
                "values": [
                  2016,
                  2018,
                  2020,
                  2022,
                  2024
                ],
                "labelExpr": "(datum.value - 1) + '–' + substring(datum.value + '', 2)",
                "labelFontSize": 11,
                "labelAngle": 0,
                "labelOverlap": true
              },
              "scale": {
                "domain": [
                  2016,
                  2024
                ],
                "nice": false
              }
            },
            "y": {
              "field": "s0",
              "type": "quantitative",
              "title": "Councils",
              "axis": {
                "values": [
                  0,
                  40,
                  79
                ],
                "domain": false,
                "ticks": false
              }
            },
            "color": {
              "field": "service",
              "type": "nominal",
              "scale": {
                "domain": [
                  "No green bin",
                  "Garden only",
                  "Food and garden",
                  "Food, garden and glass"
                ],
                "range": [
                  "#D55E00",
                  "#A6D5F2",
                  "#56B4E9",
                  "#0072B2"
                ]
              }
            },
            "tooltip": [
              {
                "field": "year_end",
                "type": "quantitative",
                "title": "Year ending",
                "format": "d"
              },
              {
                "field": "service",
                "title": "Service"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Councils"
              }
            ],
            "y2": {
              "field": "s1"
            }
          }
        },
        {
          "description": "Counts at each end of the band chart.",
          "transform": [
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "n"
                }
              ],
              "groupby": [
                "year_end",
                "service"
              ]
            },
            {
              "impute": "n",
              "key": "year_end",
              "groupby": [
                "service"
              ],
              "value": 0
            },
            {
              "calculate": "indexof(['No green bin', 'Garden only', 'Food and garden', 'Food, garden and glass'], datum.service)",
              "as": "so"
            },
            {
              "stack": "n",
              "groupby": [
                "year_end"
              ],
              "sort": [
                {
                  "field": "so",
                  "order": "ascending"
                }
              ],
              "as": [
                "s0",
                "s1"
              ]
            },
            {
              "calculate": "(datum.s0 + datum.s1) / 2",
              "as": "sm"
            },
            {
              "filter": "datum.year_end === 2016 || datum.year_end === 2024"
            },
            {
              "filter": "datum.n >= 5"
            }
          ],
          "layer": [
            {
              "transform": [
                {
                  "filter": "datum.year_end === 2016"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 5,
                "fontSize": 11.5,
                "fontWeight": 800
              },
              "encoding": {
                "x": {
                  "field": "year_end",
                  "type": "quantitative"
                },
                "y": {
                  "field": "sm",
                  "type": "quantitative"
                },
                "text": {
                  "field": "n"
                },
                "color": {
                  "condition": {
                    "test": "datum.so === 1",
                    "value": "#14171A"
                  },
                  "value": "#FFFFFF"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.year_end === 2024"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -6,
                "fontSize": 11.5,
                "fontWeight": 800
              },
              "encoding": {
                "x": {
                  "field": "year_end",
                  "type": "quantitative"
                },
                "y": {
                  "field": "sm",
                  "type": "quantitative"
                },
                "text": {
                  "field": "n"
                },
                "color": {
                  "condition": {
                    "test": "datum.so === 1",
                    "value": "#14171A"
                  },
                  "value": "#FFFFFF"
                }
              }
            }
          ]
        },
        {
          "mark": {
            "type": "rule",
            "color": "#14171A",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            }
          },
          "transform": [
            {
              "calculate": "year",
              "as": "year"
            }
          ]
        }
      ]
    }
  ],
  "background": null
}